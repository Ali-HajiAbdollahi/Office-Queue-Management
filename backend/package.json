{
  "name": "backend",
  "version": "1.0.0",
  "description": "Office Queue Management - backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 test/integration/*.test.js",
    "test:e2e": "node --env-file-if-exists=.env --test test/e2e/*.test.js",
    "test:frontend-e2e": "node --env-file-if-exists=.env scripts/run-frontend-e2e.js",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "db:inspect": "node --env-file-if-exists=.env scripts/inspect-db.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "5.3.0",
    "pg": "8.23.1"
  }
}
