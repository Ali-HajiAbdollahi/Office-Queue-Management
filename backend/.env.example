# Copy this file to .env.
# Copy the complete connection strings from Neon > Connect.
# Never commit .env.

DATABASE_URL=postgresql://ROLE:PASSWORD@YOUR-POOLED-ENDPOINT/neondb_OQM?sslmode=require
DIRECT_DATABASE_URL=postgresql://ROLE:PASSWORD@YOUR-DIRECT-ENDPOINT/neondb_OQM?sslmode=require

DB_SCHEMA=schema_OQM
PORT=3000
CORS_ORIGIN=http://localhost:8080

# Separate test database: DIRECT connection for integration tests.
# TEST_DATABASE_URL=postgresql://ROLE:PASSWORD@TEST-ENDPOINT/neondb_OQM?sslmode=require
# Or the local Postgres of compose.yaml (start it with: docker compose up -d --wait db):
# TEST_DATABASE_URL=postgresql://oqm:oqm_dev_password@127.0.0.1:5432/oqm
# The tests create (and drop) their own random schema: schema_OQM is never touched.

# Set only when existing timestamp-without-time-zone data needs conversion.
# LEGACY_TIMESTAMP_TIMEZONE=Europe/Rome